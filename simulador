<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Simulador: Pinus vs Polylepis</title>
    <style>
        body { font-family: sans-serif; background: #f0f4f0; padding: 20px; }
        .container { max-width: 900px; margin: auto; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .group-panel { background: #e8f5e9; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        canvas { background: #fff; border: 1px solid #ccc; display: block; margin: 10px auto; }
        .controls { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
        button { padding: 10px; cursor: pointer; background: #2e7d32; color: white; border: none; border-radius: 4px; }
    </style>
</head>
<body>

<div class="container">
    <h1>Simulador Comparativo: Adaptación al Estrés</h1>
    
    <div class="group-panel">
        <label>Seleccionar Grupo (1-7): </label>
        <select id="groupSelect">
            <option>Grupo 1</option><option>Grupo 2</option><option>Grupo 3</option>
            <option>Grupo 4</option><option>Grupo 5</option><option>Grupo 6</option><option>Grupo 7</option>
        </select>
        <button onclick="dibujarComparativa()">Registrar Grupo y Dibujar</button>
    </div>

    <div id="info" style="text-align: center; font-weight: bold; margin-bottom: 10px;"></div>
    <canvas id="ecoCanvas" width="800" height="300"></canvas>
    
    <div style="font-size: 0.9em; margin-top: 20px; padding: 10px; background: #fffde7;">
        <b>Análisis Bibliográfico (Smith & Smith, 2007):</b>
        <ul>
            <li><b>Pinus:</b> Alta plasticidad, colonizador, alta tasa de crecimiento si los recursos son abundantes, pero requiere inversión constante.</li>
            <li><b>Polylepis:</b> Estratega de ambientes extremos, alta inversión en raíces, baja tasa fotosintética pero gran resiliencia frente a factores limitantes.</li>
        </ul>
    </div>
</div>

<script>
    function dibujarComparativa() {
        const canvas = document.getElementById('ecoCanvas');
        const ctx = canvas.getContext('2d');
        const grp = document.getElementById('groupSelect').value;
        document.getElementById('info').innerText = "Simulación: " + grp + " - Comparativa de Inversión de Biomasa ante Estrés";

        // Limpiar
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Dibujar PINO (Estrategia flexible)
        ctx.fillStyle = "#1b5e20"; // Verde oscuro
        ctx.fillRect(150, 100, 100, 150); // Tronco
        ctx.fillStyle = "#81c784";
        ctx.beginPath(); ctx.moveTo(200, 20); ctx.lineTo(100, 100); ctx.lineTo(300, 100); ctx.fill(); // Copa
        ctx.fillStyle = "#a1887f";
        ctx.fillRect(180, 250, 40, 30); // Raíz moderada

        // Dibujar POLYLEPIS (Estrategia conservativa/radical)
        ctx.fillStyle = "#4e342e"; // Marrón
        ctx.fillRect(550, 100, 80, 100); // Tronco corto
        ctx.fillStyle = "#558b2f";
        ctx.beginPath(); ctx.arc(590, 80, 50, 0, Math.PI * 2); ctx.fill(); // Copa densa
        ctx.fillStyle = "#8d6e63";
        ctx.fillRect(500, 200, 180, 60); // Raíz muy extendida (Adaptación)

        // Textos
        ctx.fillStyle = "black";
        ctx.font = "16px Arial";
        ctx.fillText("PINUS (Valencia amplia)", 120, 290);
        ctx.fillText("POLYLEPIS (Valencia estenoica/adaptada)", 480, 290);
        
        ctx.font = "12px Arial";
        ctx.fillText("Alta inversión foliar", 140, 60);
        ctx.fillText("Alta inversión en Raíz (exploración)", 520, 240);
    }
</script>

</body>
</html>
